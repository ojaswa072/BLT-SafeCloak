{
  "name": "blt-safecloak",
  "version": "0.1.0",
  "description": "Privacy-focused peer-to-peer communication platform",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --no-reload",
    "deploy": "wrangler deploy",
    "format": "yapf -i -r src/ tests/",
    "format:check": "yapf -d -r src/ tests/",
    "typecheck": "mypy src/",
    "check": "npm run format:check && npm run typecheck",
    "setup": "npm install && python -m pip install -r requirements-dev.txt && python -m playwright install --with-deps chromium",
    "clean": "find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true"
  },
  "keywords": [
    "privacy",
    "p2p",
    "cloudflare-workers",
    "webrtc"
  ],
  "license": "MIT",
  "devDependencies": {
    "peer": "^1.0.2",
    "peerjs": "^1.5.5",
    "wrangler": "3.114.17"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}